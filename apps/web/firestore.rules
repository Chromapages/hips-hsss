rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roles are authoritative only in Commerce.User and never in Firestore claims.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['role', 'permissions', 'firebaseUid', 'createdAt', 'stripeCustomerId']);
      allow create: if false; // Creation is handled server-side via /api/auth/sync only.
    }

    // Sessions collection: participants can read their own sessions
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Privileged reads and writes are server-only.
    match /safetyAlerts/{alertId} {
      allow read, write: if false;
    }

    // Session flags are read through role-enforced server APIs.
    match /sessionFlags/{flagId} {
      allow read: if false;
      allow create: if isAuthenticated(); // Allow authenticated users to create flags
    }

    // Packages: users can read their own
    match /packages/{packageId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Scholarships: users can read their own
    match /scholarships/{scholarshipId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Write only via backend
    }

    // Inquiries: public create, server-only read
    match /inquiries/{inquiryId} {
      allow create: if true; // Public submission
      allow read: if false;
    }
  }
}
