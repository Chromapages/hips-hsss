# H.I.P.S. environment template
#
# Copy this file to .env.local for local development. Do not commit real
# secrets. Production secrets should live in a managed secret store or platform
# environment variables, not in a repository file.

# ---------------------------------------------------------------------------
# Public browser/build-time values
# These are bundled into the client when prefixed with NEXT_PUBLIC_.
# Never put private API secrets in this section.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-public-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-public-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-public-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-public-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-public-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-with-public-firebase-measurement-id

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_LIVEKIT_URL=wss://replace-me.livekit.cloud
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://replace-me.livekit.cloud

# ---------------------------------------------------------------------------
# Firebase Admin, server-only
# Prefer FIREBASE_SERVICE_ACCOUNT_KEY or FIREBASE_ADMIN_SDK_KEY as the JSON
# service-account value, or its base64 encoding. Avoid absolute local file paths
# in production.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_ADMIN_SDK_KEY=
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket

# ---------------------------------------------------------------------------
# Databases, server-only
# Use distinct users/passwords per database in real environments.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/commerce_db?schema=public
SESSION_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/session_db?schema=public
SAFETY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/safety_db?schema=public
VAULT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/vault_db?schema=public

# ---------------------------------------------------------------------------
# Central signing and encryption secrets, server-only
# Generate unique values for each secret. Do not reuse values across keys.
# Examples:
#   openssl rand -base64 32
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
SERVICE_JWT_SECRET=replace-with-unique-service-jwt-secret
SERVICE_JWT_SECRET_PRIOR=
SESSION_SERVICE_SECRET=replace-with-unique-session-service-secret
SESSION_SERVICE_SECRET_PRIOR=
SESSION_ANONYMISATION_KEY=replace-with-unique-session-anonymisation-key
HANDLE_DERIVATION_KEY=replace-with-unique-handle-derivation-key
SUDO_TOKEN_SECRET=replace-with-unique-sudo-token-secret
MFA_ENCRYPTION_KEY=replace-with-44-char-base64-32-byte-key
MFA_ENCRYPTION_KEY_PRIOR=
SAFETY_SERVICE_SECRET=replace-with-unique-legacy-safety-secret
SAFETY_SERVICE_SECRET_PRIOR=
PARTICIPANT_HASH_KEY=replace-with-unique-participant-hash-key

# ---------------------------------------------------------------------------
# Stripe and webhooks, server-only
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
LIVEKIT_WEBHOOK_SECRET=replace-with-livekit-webhook-secret
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# LiveKit, server-only unless NEXT_PUBLIC_ above
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_URL=wss://replace-me.livekit.cloud

# ---------------------------------------------------------------------------
# Enhanced voice masking worker
# Browser DSP remains the default local fallback. Enhanced mode is available
# only when this worker is reachable, live-ready, and exposes a TLS WebSocket
# that returns converted audio for the browser to publish.
# ---------------------------------------------------------------------------
VOICE_WORKER_ENABLED=false
VOICE_WORKER_LIVE_READY=false
VOICE_WORKER_RUNTIME=transport-passthrough-vad
VOICE_WORKER_PORT=3010
VOICE_WORKER_HOST=127.0.0.1
VOICE_WORKER_WS_URL=ws://127.0.0.1:3010/v1/stream
VOICE_WORKER_HEALTH_URL=http://127.0.0.1:3010/health
VOICE_WORKER_PUBLIC_WS_URL=wss://voice-mask.example.com/v1/stream
VOICE_WORKER_SHARED_SECRET=replace-with-strong-worker-secret
VOICE_WORKER_BROWSER_TOKEN=replace-with-browser-worker-token
VOICE_WORKER_TIMEOUT_MS=2500
VOICE_WORKER_CHUNK_MS=40
VOICE_WORKER_VAD_ENABLED=true
VOICE_WORKER_VAD_THRESHOLD=0.012
VOICE_WORKER_PSEUDO_SPEAKER_POLICY=session-stable
VOICE_WORKER_DSP_ENABLED=true
VOICE_WORKER_DSP_PRESET=guardian
VOICE_WORKER_DSP_PITCH_RATIO=1.18
VOICE_WORKER_DSP_RING_HZ=37
VOICE_WORKER_DSP_RING_DEPTH=0.16
VOICE_WORKER_DSP_NOISE_FLOOR=0.0045
VOICE_WORKER_DSP_DRIVE=1.65
VOICE_WORKER_DSP_LOWPASS_HZ=4800
VOICE_WORKER_DSP_HIGHPASS_HZ=115
VOICE_WORKER_DSP_FORMANT_WARP=0.72
VOICE_WORKER_DSP_CADENCE_DEPTH=0.09
VOICE_WORKER_DSP_DELAY_JITTER_MS=2.5

# ---------------------------------------------------------------------------
# Internal services, server-only
# These must be set in production. Localhost fallback is development-only.
# ---------------------------------------------------------------------------
SAFETY_ENGINE_URL=http://localhost:3003
SAFETY_SERVICE_URL=http://localhost:3003
VAULT_SERVICE_URL=http://localhost:3004
VAULT_API_SECRET=replace-with-vault-api-secret
VAULT_KMS_KEY_ID=replace-with-vault-kms-key-id
VAULT_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Storage, server-only
# STORAGE_BACKEND can be local, s3, or firebase depending on deployment.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.local-storage
STORAGE_LOCAL_HMAC_SECRET=replace-with-local-storage-hmac-secret
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
STORAGE_URL_TTL_SECONDS=900
FILES_HOST=http://localhost:3000
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Operational integrations, server-only
# ---------------------------------------------------------------------------
REDIS_URL=
CRON_SECRET=replace-with-cron-secret
RESEND_API_KEY=
HOST_ACCESS_CODE=replace-with-host-access-code
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_HTTPS_UPGRADE=false
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# ---------------------------------------------------------------------------
# Organization/contact metadata
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
COORDINATOR_EMAIL=coordinator@example.com
ORG_EIN=00-0000000
SCHOLARSHIP_DEADLINE_ISO=
SURVEY_URL=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_SERVICE_NAME=
PORT=3000
