# Firebase (Commerce Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_ADMIN_SDK_KEY=/absolute/path/to/firebase-admin.json
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Databases
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/commerce_db?schema=public
SESSION_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/session_db?schema=public
SAFETY_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/safety_db?schema=public
VAULT_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/vault_db?schema=public

# Session Service
SESSION_ANONYMISATION_KEY=your-session-anonymisation-hmac-key
HANDLE_DERIVATION_KEY=your-handle-derivation-hmac-key

# Cron
CRON_SECRET=your-cron-secret

# Internal Services
VAULT_API_SECRET=your-vault-api-secret
SESSION_SERVICE_SECRET=your-session-service-secret
SAFETY_SERVICE_SECRET=your-safety-service-secret
VAULT_KMS_KEY_ID=your-vault-kms-key-id

# LiveKit
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url
NEXT_PUBLIC_LIVEKIT_API_KEY=your-livekit-api-key
NEXT_PUBLIC_LIVEKIT_API_SECRET=your-livekit-api-secret

# Safety Engine
SAFETY_ENGINE_URL=your-safety-engine-url

# Files
FILES_HOST=your-files-host

# Email
RESEND_API_KEY=your-resend-api-key

# Host Challenge
HOST_ACCESS_CODE=your-host-access-code
