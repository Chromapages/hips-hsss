.env.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS
._*
.DS_Store
**/.DS_Store

# Prisma Generated Clients
packages/db/generated/
**/generated/

# Downloaded voice-conversion model weights/cache
deploy/voice-changer/pretrain/

# Local voice evaluation datasets and generated benchmark runs
tools/voice-eval/data/
tools/voice-eval/runs/

# Firebase Admin Service Account Key
firebase-admin.json
